"use client";

import { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { supabase } from "@/utils/supabase/client";

type ExpenseRequest = {
  id: string;
  created_at: string;
  request_date: string;
  requester_name: string;
  position: string;
  reason: string;
  amount: number;
  status: string;
  admin_seen_at?: string | null;
};

type ClearingSummary = {
  request_id: string;
  total_expenses: number | string | null;
  requested_amount?: number | string | null;
};

const STATUS_NEW = "ใบเบิกใหม่";
const STATUS_WAITING = "รอเคลียร์";
const STATUS_CLEARED = "เคลียร์บิลแล้ว";

type Category = "all" | "new" | "waiting" | "cleared";

export default function AdminPage() {
  const router = useRouter();

  const [requests, setRequests] = useState<ExpenseRequest[]>([]);
  const [clearings, setClearings] = useState<ClearingSummary[]>([]);
  const [loading, setLoading] = useState(true);
  const [confirming, setConfirming] = useState(false);
  const [error, setError] = useState("");
  const [actionMessage, setActionMessage] = useState("");
  const [activeTab, setActiveTab] = useState<Category>("all");
  const [selectedRequest, setSelectedRequest] =
    useState<ExpenseRequest | null>(null);

  useEffect(() => {
    void loadRequests();
  }, []);

  async function loadRequests() {
    setLoading(true);
    setError("");

    const [requestResult, clearingResult] = await Promise.all([
      supabase
        .from("expense_requests")
        .select("*")
        .order("created_at", { ascending: false }),
      supabase
        .from("expense_clearings")
        .select("request_id,total_expenses,requested_amount"),
    ]);

    if (requestResult.error) {
      console.error(requestResult.error);
      setError(requestResult.error.message);
      setLoading(false);
      return;
    }

    setRequests((requestResult.data || []) as ExpenseRequest[]);

    if (clearingResult.error) {
      console.error(
        "โหลดข้อมูลสรุปการเคลียร์ไม่สำเร็จ:",
        clearingResult.error
      );
      setClearings([]);
      setActionMessage(
        "โหลดรายการใบเบิกได้ แต่ข้อมูลยอดเคลียร์บางส่วนอ่านไม่ได้ กรุณาตรวจสอบตาราง expense_clearings"
      );
    } else {
      setClearings((clearingResult.data || []) as ClearingSummary[]);
      setActionMessage("");
    }

    setLoading(false);
  }

  function formatMoney(amount: number) {
    return Number(amount || 0).toLocaleString("th-TH", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
  }

  function formatDate(date: string) {
    if (!date) return "-";

    const [year, month, day] = date.split("-");
    return `${day}/${month}/${Number(year) + 543}`;
  }

  function formatDateTime(date: string) {
    if (!date) return "-";

    const parsed = new Date(date);

    if (Number.isNaN(parsed.getTime())) return "-";

    return parsed.toLocaleString("th-TH", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
  }

  const newRequests = requests.filter(
    (request) => request.status === STATUS_NEW
  );

  const waitingRequests = requests.filter(
    (request) => request.status === STATUS_WAITING
  );

  const clearedRequests = requests.filter(
    (request) => request.status === STATUS_CLEARED
  );

  const visibleRequests =
    activeTab === "all"
      ? requests
      : activeTab === "new"
        ? newRequests
        : activeTab === "waiting"
          ? waitingRequests
          : clearedRequests;

  const pendingAmount = [...newRequests, ...waitingRequests].reduce(
    (sum, request) => sum + Number(request.amount || 0),
    0
  );

  const requestedTotal = requests.reduce(
    (sum, request) => sum + Number(request.amount || 0),
    0
  );

  const clearedActualTotal = clearings.reduce(
    (sum, clearing) => sum + Number(clearing.total_expenses || 0),
    0
  );

  const clearedRequestedTotal = clearedRequests.reduce(
    (sum, request) => sum + Number(request.amount || 0),
    0
  );

  const differenceTotal = clearedRequestedTotal - clearedActualTotal;

  async function acknowledgeRequest() {
    if (!selectedRequest || confirming) return;

    const confirmed = window.confirm(
      `ยืนยันรับทราบใบเบิกของ ${selectedRequest.requester_name} จำนวน ${formatMoney(
        selectedRequest.amount
      )} บาท ใช่หรือไม่?`
    );

    if (!confirmed) return;

    setConfirming(true);
    setError("");
    setActionMessage("");

    const { data, error } = await supabase
      .from("expense_requests")
      .update({
        status: STATUS_WAITING,
        admin_seen_at: new Date().toISOString(),
      })
      .eq("id", selectedRequest.id)
      .eq("status", STATUS_NEW)
      .select("id")
      .maybeSingle();

    if (error) {
      console.error(error);
      setError(`รับทราบใบเบิกไม่สำเร็จ: ${error.message}`);
      setConfirming(false);
      return;
    }

    if (!data) {
      setError(
        "รายการนี้อาจถูกดำเนินการไปแล้ว กรุณาโหลดข้อมูลใหม่แล้วตรวจสอบสถานะ"
      );
      setConfirming(false);
      return;
    }

    setSelectedRequest(null);
    setActiveTab("waiting");
    setActionMessage("รับทราบใบเบิกแล้ว รายการย้ายไปหมวดรอเคลียร์บิล");
    setConfirming(false);

    await loadRequests();
  }

  function statusClass(status: string) {
    if (status === STATUS_CLEARED) {
      return "bg-green-100 text-green-700";
    }

    if (status === STATUS_WAITING) {
      return "bg-orange-100 text-orange-700";
    }

    return "bg-red-100 text-red-700";
  }

  function openRequest(request: ExpenseRequest) {
    if (request.status === STATUS_NEW) {
      setSelectedRequest(request);
      return;
    }

    router.push(`/clear/${request.id}`);
  }

  const categoryCards: {
    id: Category;
    title: string;
    count: number;
    description: string;
    color: "red" | "orange" | "green" | "blue";
  }[] = [
    {
      id: "new",
      title: "🔴 ใบเบิกใหม่",
      count: newRequests.length,
      description: "รายการที่รอรับทราบ",
      color: "red",
    },
    {
      id: "waiting",
      title: "🟠 รอเคลียร์บิล",
      count: waitingRequests.length,
      description: "รายการที่รอเคลียร์ค่าใช้จ่าย",
      color: "orange",
    },
    {
      id: "cleared",
      title: "🟢 เคลียร์บิลแล้ว",
      count: clearedRequests.length,
      description: "รายการที่เคลียร์เรียบร้อย",
      color: "green",
    },
    {
      id: "all",
      title: "📋 ใบเบิกทั้งหมด",
      count: requests.length,
      description: "ทุกสถานะในระบบ",
      color: "blue",
    },
  ];

  const cardColors = {
    red: {
      active: "border-red-400 bg-red-50 ring-2 ring-red-200",
      inactive: "border-red-200 bg-white hover:bg-red-50",
      title: "text-red-600",
      count: "text-red-600",
    },
    orange: {
      active: "border-orange-400 bg-orange-50 ring-2 ring-orange-200",
      inactive: "border-orange-200 bg-white hover:bg-orange-50",
      title: "text-orange-600",
      count: "text-orange-600",
    },
    green: {
      active: "border-green-400 bg-green-50 ring-2 ring-green-200",
      inactive: "border-green-200 bg-white hover:bg-green-50",
      title: "text-green-600",
      count: "text-green-600",
    },
    blue: {
      active: "border-blue-400 bg-blue-50 ring-2 ring-blue-200",
      inactive: "border-blue-200 bg-white hover:bg-blue-50",
      title: "text-blue-600",
      count: "text-blue-600",
    },
  };

  const activeCategoryTitle =
    activeTab === "all"
      ? "📋 รายการใบเบิกทั้งหมด"
      : activeTab === "new"
        ? "🔴 รายการใบเบิกใหม่"
        : activeTab === "waiting"
          ? "🟠 รายการรอเคลียร์บิล"
          : "🟢 รายการเคลียร์บิลแล้ว";

  return (
    <main className="min-h-screen bg-slate-50 p-4 text-slate-800 sm:p-8">
      <div className="mx-auto max-w-6xl">
                <header className="flex flex-wrap items-center justify-between gap-4">
          <div>
            <p className="text-sm font-semibold text-blue-700">
              EXPENSE MANAGEMENT
            </p>
            <h1 className="mt-2 text-3xl font-bold">ระบบหลังบ้าน</h1>
            <p className="mt-2 text-sm text-slate-500">
              จัดการใบเบิกเงินและตรวจสอบสถานะการเคลียร์บิล
            </p>
          </div>

          <button
            type="button"
            onClick={() => router.push("/summary")}
            className="rounded-xl bg-blue-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-800"
          >
            📊 สรุปการเงิน
          </button>
        </header>

        {/* การ์ดเลือกหมวดรายการ */}
        <section className="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {categoryCards.map((card) => {
            const colors = cardColors[card.color];
            const isActive = activeTab === card.id;

            return (
              <button
                key={card.id}
                type="button"
                aria-pressed={isActive}
                onClick={() => {
                  setActiveTab(card.id);
                  setSelectedRequest(null);
                }}
                className={`rounded-2xl border p-5 text-left shadow-sm transition ${
                  isActive ? colors.active : colors.inactive
                }`}
              >
                <p className={`text-sm font-semibold ${colors.title}`}>
                  {card.title}
                </p>
                <p className={`mt-2 text-3xl font-bold ${colors.count}`}>
                  {card.count}
                </p>
                <p className="mt-2 text-sm text-slate-500">
                  {card.description}
                </p>
                {isActive && (
                  <p className="mt-3 text-xs font-semibold text-slate-500">
                    ✓ กำลังแสดงหมวดนี้
                  </p>
                )}
              </button>
            );
          })}
        </section>

        {/* สรุปยอดเงิน */}
        <section className="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div className="flex flex-wrap items-center justify-between gap-3">
            <h2 className="text-xl font-bold">สรุปยอดเงิน</h2>
            <button
              type="button"
              onClick={() => void loadRequests()}
              disabled={loading}
              className="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm hover:bg-slate-50 disabled:opacity-50"
            >
              ↻ โหลดข้อมูลใหม่
            </button>
          </div>

          <div className="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div className="rounded-xl bg-blue-50 p-4">
              <p className="text-sm text-slate-600">
                ยอดเงินตามใบเบิกทั้งหมด
              </p>
              <p className="mt-2 text-xl font-bold text-blue-700">
                {formatMoney(requestedTotal)} บาท
              </p>
            </div>

            <div className="rounded-xl bg-orange-50 p-4">
              <p className="text-sm text-slate-600">
                ยอดใบเบิกที่ยังรอเคลียร์
              </p>
              <p className="mt-2 text-xl font-bold text-orange-700">
                {formatMoney(pendingAmount)} บาท
              </p>
            </div>

            <div className="rounded-xl bg-green-50 p-4">
              <p className="text-sm text-slate-600">
                ค่าใช้จ่ายจริงที่เคลียร์แล้ว
              </p>
              <p className="mt-2 text-xl font-bold text-green-700">
                {formatMoney(clearedActualTotal)} บาท
              </p>
            </div>

            <div className="rounded-xl bg-slate-100 p-4">
              <p className="text-sm text-slate-600">
                ส่วนต่างของใบที่เคลียร์แล้ว
              </p>
              <p className="mt-2 text-xl font-bold text-slate-800">
                {formatMoney(differenceTotal)} บาท
              </p>
            </div>
          </div>

          <p className="mt-3 text-xs text-slate-500">
            ส่วนต่าง = ยอดเงินตามใบเบิกของรายการที่เคลียร์แล้ว − ค่าใช้จ่ายจริง
            ยอดสรุปจะถูกต้องเมื่อระบบอ่านข้อมูลใบเคลียร์ได้ครบ
          </p>
        </section>

        {/* รายการตามหมวดที่เลือก */}
        <section className="mt-8">
          <div className="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 className="text-xl font-bold">{activeCategoryTitle}</h2>
              <p className="mt-1 text-sm text-slate-500">
                แสดง {visibleRequests.length} รายการ
              </p>
            </div>

            <button
              type="button"
              onClick={() => void loadRequests()}
              disabled={loading}
              className="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm hover:bg-slate-50 disabled:opacity-50"
            >
              ↻ โหลดข้อมูลใหม่
            </button>
          </div>

          {actionMessage && (
            <div className="mt-4 rounded-xl border border-green-200 bg-green-50 p-3 text-sm text-green-800">
              {actionMessage}
            </div>
          )}

          {loading && (
            <div className="mt-5 py-6 text-center text-sm text-slate-500">
              กำลังโหลดข้อมูล...
            </div>
          )}

          {!loading && error && (
            <div className="mt-5 rounded-xl border border-red-200 bg-red-50 p-4">
              <p className="font-semibold text-red-700">มีข้อผิดพลาด</p>
              <p className="mt-2 break-words text-sm text-red-600">
                {error}
              </p>
              <button
                type="button"
                onClick={() => void loadRequests()}
                className="mt-4 rounded-lg bg-red-600 px-4 py-2 text-white"
              >
                ลองอีกครั้ง
              </button>
            </div>
          )}

          {!loading && !error && visibleRequests.length === 0 && (
            <p className="mt-5 rounded-xl border border-dashed border-slate-300 px-4 py-6 text-center text-sm text-slate-500">
              ไม่มีรายการในหมวดนี้
            </p>
          )}

          {!loading && !error && visibleRequests.length > 0 && (
            <div className="mt-5 space-y-4">
              {visibleRequests.map((request) => (
                <article
                  key={request.id}
                  className={`rounded-2xl border bg-white p-5 shadow-sm ${
                    request.status === STATUS_NEW
                      ? "border-red-200"
                      : "border-slate-200"
                  }`}
                >
                  <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                    <div className="min-w-0 flex-1">
                      <div className="flex flex-wrap items-center gap-2">
                        <span
                          className={`rounded-full px-3 py-1 text-xs font-semibold ${statusClass(
                            request.status
                          )}`}
                        >
                          {request.status}
                        </span>

                        {request.status === STATUS_NEW && (
                          <span className="text-xs font-bold text-red-600">
                            🔴 ใหม่
                          </span>
                        )}
                      </div>

                      <h3 className="mt-3 text-lg font-bold">
                        {request.requester_name}
                      </h3>

                      <p className="mt-1 text-sm text-slate-500">
                        {request.position}
                      </p>

                      <div className="mt-3 space-y-1 text-sm">
                        <p>
                          <span className="font-medium">วันที่เบิก:</span>{" "}
                          {formatDate(request.request_date)}
                        </p>
                        <p className="break-words">
                          <span className="font-medium">เหตุผล:</span>{" "}
                          {request.reason}
                        </p>
                      </div>
                    </div>

                    <div className="sm:min-w-44 sm:text-right">
                      <p className="text-sm text-slate-500">
                        จำนวนเงินที่เบิก
                      </p>
                      <p className="mt-1 text-2xl font-bold">
                        {formatMoney(request.amount)} บาท
                      </p>

                      {request.status === STATUS_NEW ? (
                        <button
                          type="button"
                          onClick={() => setSelectedRequest(request)}
                          className="mt-4 w-full rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-700 sm:w-auto"
                        >
                          เปิดตรวจสอบใบเบิก
                        </button>
                      ) : (
                        <button
                          type="button"
                          onClick={() => router.push(`/clear/${request.id}`)}
                          className="mt-4 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold hover:bg-slate-50 sm:w-auto"
                        >
                          {request.status === STATUS_CLEARED
                            ? "ดูรายละเอียด"
                            : "เปิดใบเคลียร์บิล"}
                        </button>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>

        {/* หน้าต่างตรวจสอบและรับทราบใบเบิก */}
        {selectedRequest && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
            <section className="w-full max-w-lg rounded-2xl bg-white p-6 shadow-xl">
              <div className="flex items-start justify-between gap-3">
                <div>
                  <p className="text-sm font-semibold text-red-600">
                    🔴 ตรวจสอบใบเบิกใหม่
                  </p>
                  <h2 className="mt-2 text-2xl font-bold">
                    {selectedRequest.requester_name}
                  </h2>
                </div>

                <button
                  type="button"
                  onClick={() => setSelectedRequest(null)}
                  className="rounded-lg border px-3 py-1 text-sm hover:bg-slate-50"
                >
                  ปิด
                </button>
              </div>

              <div className="mt-5 space-y-3 rounded-xl bg-slate-50 p-4 text-sm">
                <p>
                  <span className="font-semibold">ตำแหน่ง:</span>{" "}
                  {selectedRequest.position || "-"}
                </p>
                <p>
                  <span className="font-semibold">วันที่เบิก:</span>{" "}
                  {formatDate(selectedRequest.request_date)}
                </p>
                <p className="break-words">
                  <span className="font-semibold">เหตุผลในการเบิก:</span>{" "}
                  {selectedRequest.reason || "-"}
                </p>
                <div className="border-t border-slate-200 pt-3">
                  <p className="text-slate-500">จำนวนเงินที่ขอเบิก</p>
                  <p className="mt-1 text-2xl font-bold text-blue-700">
                    {formatMoney(selectedRequest.amount)} บาท
                  </p>
                </div>
              </div>

              <p className="mt-4 text-sm text-slate-500">
                เมื่อตกลงรับทราบแล้ว ใบเบิกนี้จะย้ายไปหมวด “รอเคลียร์บิล”
                และสามารถเปิดใบเคลียร์บิลได้
              </p>

              <button
                type="button"
                onClick={() => void acknowledgeRequest()}
                disabled={confirming}
                className="mt-5 w-full rounded-xl bg-green-600 px-4 py-3 font-semibold text-white hover:bg-green-700 disabled:opacity-50"
              >
                {confirming
                  ? "กำลังบันทึก..."
                  : "ตกลง / รับทราบใบเบิก"}
              </button>
            </section>
          </div>
        )}
      </div>
    </main>
  );
}